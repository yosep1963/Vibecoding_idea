# GitHub Personal Access Token (read 권한만 필요)
# https://github.com/settings/tokens 에서 생성
GITHUB_TOKEN=ghp_your_token_here
GITHUB_USERNAME=your_username

# Claude 인증 (Phase 3 vibe recommend 에서만 필요)
# 권장 방법: `claude setup-token` 실행하면 ~/.claude/.credentials.json 에 자동 저장됨.
# 그 경우 아래 줄은 빈 채로 둬도 됨 (SDK가 저장된 자격증명을 자동 사용).
# 환경변수로 직접 지정하려면 주석 해제:
# CLAUDE_CODE_OAUTH_TOKEN=

# Ollama (로컬에서 돌아가므로 기본값으로 OK)
OLLAMA_HOST=http://localhost:11434
